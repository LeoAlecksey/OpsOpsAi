{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpsOpsAi",
  "version": "0.2.1",
  "identifier": "app.opsopsai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpsOpsAi",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#0d0f14"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local AI chat and agents on your computer",
    "longDescription": "OpsOpsAi runs AI models locally: install the app, pick a model that fits your computer and chat without the cloud.",
    "publisher": "LeoAlecksey",
    "copyright": "Copyright (c) 2026 LeoAlecksey. All rights reserved.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxQ0ZENUU4QkE5MDgzQzEKUldUQmc1QzY2TlhQSWMzNXhXOW5Dekhtc0NqT01hQ1lQb3VxOVRBK0gySXRmSElIZUdqekdYbGUK",
      "endpoints": [
        "https://github.com/LeoAlecksey/OpsOpsAi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
